# payload cms
PAYLOAD_SECRET=replace-with-a-secure-random-string
# local dev (no TLS): postgresql://payload:password@127.0.0.1:5432/nyala_payload
# self-hosted with TLS (e.g. Vercel → this server): postgresql://payload:password@db.example.com:5432/nyala_payload?sslmode=require
# hosted (e.g. neon): postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/nyala_payload

# preview (draft + live) — must match your live site origin (admin CSRF / client config)
PREVIEW_SECRET=replace-with-a-secure-preview-secret
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# optional alias Payload reads in some places; usually same as NEXT_PUBLIC_SERVER_URL
# PAYLOAD_PUBLIC_SERVER_URL=https://your-domain.vercel.app

# cloudflare r2 storage
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET=nyalalabs-media
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# optional: set to 1 on Vercel (temporarily) to log parsed DATABASE hostname + key env presence in build logs — no passwords printed
# DEBUG_PAYLOAD_ENV=1

# mongodb (scraped Luma/GDG events for the /events page)
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/
